    - 992
    - 368
    rotation: 0
    state: enabled
- name: blocks_add_xx_0
  id: blocks_add_xx
  parameters:
    alias: ''
    comment: 'Suma complementaria QCC: A + B'
    affinity: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    type: 'complex'
    num_inputs: '2'
    vlen: 'n_vec'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1176
    - 288
    rotation: 0
    state: enabled
- name: blocks_complex_to_mag_0
  id: blocks_complex_to_mag
  parameters:
    alias: ''
    comment: 'Envolvente |Z|'
    affinity: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    vlen: 'n_vec'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1176
    - 456
    rotation: 0
    state: enabled
- name: blocks_integrate_xx_0
  id: blocks_integrate_xx
  parameters:
    alias: ''
    comment: 'Suma de K perfiles'
    affinity: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    type: 'float'
    decim: 'K'
    vlen: 'n_vec'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 976
    - 456
    rotation: 0
    state: enabled
- name: blocks_multiply_const_vxx_0
  id: blocks_multiply_const_vxx
  parameters:
