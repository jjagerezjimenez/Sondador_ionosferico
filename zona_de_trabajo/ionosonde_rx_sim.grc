- name: zeromq_pub_sink_0
  id: zeromq_pub_sink
  parameters:
    alias: ''
    comment: 'Perfil promediado hacia ionogram_gui.py'
    affinity: ''
    maxoutbuf: '0'
    minoutbuf: '0'
