- name: programador_barrido
  id: epy_block
  parameters:
    K: K
    _source_code: "\"\"\"\nProgramador del barrido de frecuencia (receptor real).\n\
      \nDeja pasar la senal sin modificarla y, cada 2*K disparos (una frecuencia de\n\
      sondeo = K parejas A/B), agrega en la primera muestra el tag\n'sondeo' = {f_mhz,\
      \ paso_mhz, paso, n_pasos, barrido, modo}, el mismo que usa la\nsimulacion.\
      \ Asi el armado del ionograma sabe a que frecuencia corresponde cada\nperfil\
      \ integrado.\n\nAdemas publica por el puerto de mensajes 'freq' un diccionario\
      \ {'freq': f_Hz}\nal empezar cada frecuencia, para sintonizar el hardware (TX\
      \ y DDC de la Red\nPitaya). PENDIENTE: conectarlo al bloque que controle el\
      \ hardware. El plan de\nbarrido supone que el transmisor cambia de frecuencia\
      \ en el mismo instante\n(cada 2*K*n_vec muestras desde el arranque).\n\"\"\"\
      \nimport numpy as np\nimport pmt\nfrom gnuradio import gr\n\nTAG_SONDEO = pmt.intern('sondeo')\n\
      PUERTO_FREQ = pmt.intern('freq')\n\n\nclass blk(gr.sync_block):\n    \"\"\"\
      Programador del barrido: marca cada frecuencia de sondeo con el tag 'sondeo'\n\
      \    (cada 2*K disparos) y publica {'freq': Hz} por el puerto de mensajes 'freq'.\"\
      \"\"\n\n    def __init__(self, n_vec=3333, K=25, modo_barrido=1, f_fija=5.0,\
      \ f_ini=1.0, f_fin=20.0,\n                 paso_mhz=0.1):\n        gr.sync_block.__init__(self,\
      \ name='Programador del barrido',\n                               in_sig=[np.complex64],\
      \ out_sig=[np.complex64])\n        self.message_port_register_out(PUERTO_FREQ)\n\
      \        self._muestras_por_paso = 2 * int(K) * int(n_vec)\n        # Parametros\
      \ que se pueden cambiar en ejecucion (callbacks de GRC)\n        self.modo_barrido,\
      \ self.f_fija = modo_barrido, f_fija\n        self.f_ini, self.f_fin, self.paso_mhz\
      \ = f_ini, f_fin, paso_mhz\n        self._barrido = 0\n        self._i_paso\
      \ = 0\n        self._frecuencias = None\n        self._clave_barrido = None\n\
      \n    def _siguiente_frecuencia(self):\n        if int(self.modo_barrido) ==\
      \ 0:\n            self._clave_barrido = None\n            f = float(self.f_fija)\n\
      \            return f, {'f_mhz': f, 'paso_mhz': 0.0, 'paso': 0, 'n_pasos': 1,\n\
      \                       'barrido': self._barrido, 'modo': 'fija'}\n        clave\
      \ = (float(self.f_ini), float(self.f_fin), float(self.paso_mhz))\n        if\
      \ clave != self._clave_barrido:          # cambio de barrido: empezar de nuevo\n\
      \            f_ini, f_fin, paso = clave\n            self._frecuencias = np.round(np.arange(f_ini,\
      \ f_fin + paso / 2.0, paso), 4)\n            self._clave_barrido = clave\n \
      \           self._i_paso = 0\n            self._barrido += 1\n        elif self._i_paso\
      \ >= len(self._frecuencias):\n            self._i_paso = 0\n            self._barrido\
      \ += 1\n        f = float(self._frecuencias[self._i_paso])\n        info = {'f_mhz':\
      \ f, 'paso_mhz': float(self.paso_mhz), 'paso': self._i_paso,\n             \
      \   'n_pasos': len(self._frecuencias), 'barrido': self._barrido, 'modo': 'barrido'}\n\
      \        self._i_paso += 1\n        return f, info\n\n    def work(self, input_items,\
      \ output_items):\n        n = len(input_items[0])\n        output_items[0][:]\
      \ = input_items[0]\n        inicio = self.nitems_written(0)\n        L = self._muestras_por_paso\n\
      \        primero = -(-inicio // L) * L                 # proximo limite de frecuencia\n\
      \        for offset in range(primero, inicio + n, L):\n            f, info =\
      \ self._siguiente_frecuencia()\n            self.add_item_tag(0, offset, TAG_SONDEO,\
      \ pmt.to_pmt(info))\n            self.message_port_pub(PUERTO_FREQ, pmt.to_pmt({'freq':\
      \ f * 1e6}))\n        return n\n"
    affinity: ''
    alias: ''
    comment: 'Programador del barrido: tag ''sondeo''

      cada 2K disparos + mensaje ''freq''

      (PENDIENTE: conectar a la sintonia

      del hardware)'
    f_fija: f_fija
    f_fin: f_fin
    f_ini: f_ini
    maxoutbuf: '0'
    minoutbuf: '0'
    modo_barrido: modo_barrido
    n_vec: n_vec
    paso_mhz: paso_mhz
  states:
    _io_cache: '(''Programador del barrido'', ''blk'', [(''n_vec'', ''3333''), (''K'',
      ''25''), (''modo_barrido'', ''1''), (''f_fija'', ''5.0''), (''f_ini'', ''1.0''),
      (''f_fin'', ''20.0''), (''paso_mhz'', ''0.1'')], [(''0'', ''complex'', 1)],
      [(''0'', ''complex'', 1), (''freq'', ''message'', 1)], "Programador del barrido:
      marca cada frecuencia de sondeo con el tag ''sondeo''\n    (cada 2*K disparos)
      y publica {''freq'': Hz} por el puerto de mensajes ''freq''.", [''f_fija'',
      ''f_fin'', ''f_ini'', ''modo_barrido'', ''paso_mhz''])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [816, 368]
    rotation: 0
    state: enabled
