  parameters:
    comment: 'PRF nominal [Hz]. OJO: el TX debe

      disparar cada n_vec muestras

      (PRF real = samp_rate/n_vec)'
    value: '60'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
