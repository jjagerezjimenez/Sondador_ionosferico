- name: taps_A
  id: variable
  parameters:
    comment: 'Filtro adaptado A: codigo

      invertido y sobremuestreado x6'
    value: np.repeat(code_B if swap_ab else code_A, spb)[::-1].astype(complex).tolist()
  states:
