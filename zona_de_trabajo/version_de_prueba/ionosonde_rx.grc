  parameters:
    alias: ''
    code: '# Interfaz grafica: panel de control + pestanas de graficos.

      # El codigo esta en ionosonde_gui.py (misma carpeta que este .grc).

      import os, sys

      sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

      import ionosonde_gui

      self._gui = ionosonde_gui.instalar(self)'
    comment: 'Arma la GUI (controles + pestanas)

      definida en ionosonde_gui.py'
    priority: '0'
    section: main_after_init
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 204]
    rotation: 0
    state: enabled
- name: ionograma
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nArmado del ionograma.\n\nRecibe cada perfil de altura ya\
      \ integrado (vector de n_h alturas,\nh = i * dh_km) y, con el tag 'sondeo' que\
      \ viaja junto al perfil, sabe a que\nfrecuencia corresponde. Guarda:\n  * matriz_db[f,\
      \ h]: ionograma en dB sobre el piso de ruido de cada perfil\n    (piso = mediana\
      \ del perfil).\n  * traza_h[f]: altura del eco mas fuerte (si supera 'umbral_db').\n\
      \  * ultimo: el ultimo perfil recibido (lineal y en dB) con su frecuencia.\n\
      \  * historial: los ultimos perfiles en dB (para el grafico altura-tiempo).\n\
      La interfaz grafica lee estos atributos.\n\"\"\"\nimport collections\nimport\
      \ threading\nimport numpy as np\nimport pmt\nfrom gnuradio import gr\n\nTAG_SONDEO\
      \ = pmt.intern('sondeo')\n\n\nclass blk(gr.sync_block):\n    \"\"\"Armado del\
      \ ionograma h'(f): ubica cada perfil integrado en la columna de su\n    frecuencia\
      \ (leida del tag 'sondeo') y detecta el eco mas fuerte.\"\"\"\n\n    def __init__(self,\
      \ n_h=3200, dh_km=0.7494811, f_min=1.0, f_max=20.0, df_grilla=0.05,\n      \
      \           umbral_db=12.0, h_min_km=80.0):\n        gr.sync_block.__init__(self,\
      \ name='Armado del ionograma',\n                               in_sig=[(np.float32,\
      \ int(n_h))], out_sig=None)\n        self.n_h = int(n_h)\n        self.dh_km\
      \ = float(dh_km)\n        self.f_min, self.f_max, self.df = float(f_min), float(f_max),\
      \ float(df_grilla)\n        self.n_f = int(round((self.f_max - self.f_min) /\
      \ self.df)) + 1\n        self.umbral_db = umbral_db\n        self._i_hmin =\
      \ int(np.ceil(float(h_min_km) / self.dh_km))\n        self.lock = threading.Lock()\n\
      \        self._info = {}\n        self.contador = 0\n        self.ultimo = None\
      \                                 # (contador, info, perfil_lin, perfil_db)\n\
      \        self.historial = collections.deque(maxlen=200)     # (info, perfil_db)\n\
      \        self.limpiar()\n\n    def limpiar(self):\n        with self.lock:\n\
      \            self.matriz_db = np.full((self.n_f, self.n_h), np.nan, np.float32)\n\
      \            self.traza_h = np.full(self.n_f, np.nan)\n            self.traza_db\
      \ = np.full(self.n_f, np.nan)\n\n    def columnas(self, f_mhz, paso_mhz):\n\
      \        \"\"\"Columnas de la grilla de frecuencia que cubre un paso del barrido.\"\
      \"\"\n        ancho = max(float(paso_mhz), self.df)\n        i0 = int(np.floor((f_mhz\
      \ - ancho / 2.0 - self.f_min) / self.df + 0.5))\n        i1 = int(np.floor((f_mhz\
      \ + ancho / 2.0 - self.f_min) / self.df + 0.5))\n        i0, i1 = max(i0, 0),\
      \ min(max(i1, i0 + 1), self.n_f)\n        return i0, i1\n\n    def work(self,\
      \ input_items, output_items):\n        perfiles = input_items[0]\n        n\
      \ = len(perfiles)\n        base = self.nitems_read(0)\n        info_en = {t.offset\
      \ - base: pmt.to_python(t.value)\n                   for t in self.get_tags_in_window(0,\
      \ 0, n, TAG_SONDEO)}\n        for j in range(n):\n            if j in info_en:\n\
      \                self._info = info_en[j]\n            perfil = np.array(perfiles[j],\
      \ dtype=np.float32)\n            piso = float(np.median(perfil)) or 1e-12\n\
      \            perfil_db = 20.0 * np.log10(np.maximum(perfil, 1e-12) / piso)\n\
      \            f = self._info.get('f_mhz')\n            with self.lock:\n    \
      \            if f is not None and self.f_min - self.df <= f <= self.f_max +\
      \ self.df:\n                    i0, i1 = self.columnas(f, self._info.get('paso_mhz',\
      \ 0.0))\n                    self.matriz_db[i0:i1] = perfil_db\n           \
      \         k = self._i_hmin + int(np.argmax(perfil_db[self._i_hmin:]))\n    \
      \                detectado = perfil_db[k] >= float(self.umbral_db)\n       \
      \             self.traza_h[i0:i1] = k * self.dh_km if detectado else np.nan\n\
      \                    self.traza_db[i0:i1] = perfil_db[k] if detectado else np.nan\n\
      \                self.contador += 1\n                self.ultimo = (self.contador,\
      \ dict(self._info), perfil, perfil_db)\n                self.historial.append((dict(self._info),\
      \ perfil_db))\n        return n\n"
    affinity: ''
    alias: ''
    comment: 'Armado del ionograma h''(f):

      ubica cada perfil en la columna

      de su frecuencia (tag ''sondeo'')'
    df_grilla: '0.05'
    dh_km: dh_km
    f_max: f_fin
    f_min: f_ini
    h_min_km: '80.0'
    maxoutbuf: '0'
    minoutbuf: '0'
    n_h: n_h
    umbral_db: '14.0'
  states:
    _io_cache: '(''Armado del ionograma'', ''blk'', [(''n_h'', ''3200''), (''dh_km'',
      ''0.7494811''), (''f_min'', ''1.0''), (''f_max'', ''20.0''), (''df_grilla'',
      ''0.05''), (''umbral_db'', ''12.0''), (''h_min_km'', ''80.0'')], [(''0'', ''float'',
      3200)], [], "Armado del ionograma h''(f): ubica cada perfil integrado en la
      columna de su\n    frecuencia (leida del tag ''sondeo'') y detecta el eco mas
      fuerte.", [''dh_km'', ''f_max'', ''f_min'', ''n_h'', ''umbral_db''])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [3016, 360]
    rotation: 0
    state: enabled
- name: monitor_correl
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nMonitor de la compresion de pulso (solo visualizacion).\n\
      \nEntradas (una muestra por muestra de disparo, n_vec por pareja):\n  0: salida\
      \ del correlador A, 1: salida del correlador B, 2: suma A + B.\nCada 'cada_n_parejas'\
      \ parejas copia los n_vec valores de cada entrada.\nUsa la misma regla que el\
      \ monitor de la senal recibida, asi la GUI puede\ncomparar la misma pareja en\
      \ los dos monitores.\n\"\"\"\nimport collections\nimport threading\nimport numpy\
      \ as np\nimport pmt\nfrom gnuradio import gr\n\nTAG_SONDEO = pmt.intern('sondeo')\n\
      \n\nclass blk(gr.sync_block):\n    \"\"\"Monitor (para la GUI): guarda cada\
      \ tanto la salida de los correladores A y B\n    y de la suma A + B para una\
      \ misma pareja de disparos.\"\"\"\n\n    def __init__(self, n_vec=3333, cada_n_parejas=6):\n\
      \        gr.sync_block.__init__(self, name='Monitor compresion de pulso',\n\
      \                               in_sig=[np.complex64, np.complex64, np.complex64],\
      \ out_sig=None)\n        self._n = int(n_vec)\n        self._cada = max(1, int(cada_n_parejas))\n\
      \        self._info = {}\n        self._cap = None\n        self.lock = threading.Lock()\n\
      \        self.capturas = collections.deque(maxlen=8)   # (n_pareja, info, A,\
      \ B, A+B)\n\n    def work(self, input_items, output_items):\n        n = len(input_items[0])\n\
      \        base = self.nitems_read(2)\n        tags = sorted(self.get_tags_in_window(2,\
      \ 0, n, TAG_SONDEO), key=lambda t: t.offset)\n        it = 0\n        i = 0\n\
      \        while i < n:\n            pos = base + i\n            while it < len(tags)\
      \ and tags[it].offset <= pos:\n                self._info = pmt.to_python(tags[it].value)\n\
      \                it += 1\n            if self._cap is None:\n              \
      \  resto = pos % self._n\n                if resto:\n                    i +=\
      \ self._n - resto\n                    continue\n                pareja = pos\
      \ // self._n\n                if pareja % self._cada:\n                    i\
      \ += self._n\n                    continue\n                self._cap = [pareja,\
      \ dict(self._info)] + \\\n                    [np.empty(self._n, np.complex64)\
      \ for _ in range(3)] + [0]\n            cap = self._cap\n            k = min(self._n\
      \ - cap[5], n - i)\n            for j in range(3):\n                cap[2 +\
      \ j][cap[5]:cap[5] + k] = input_items[j][i:i + k]\n            cap[5] += k\n\
      \            i += k\n            if cap[5] == self._n:\n                with\
      \ self.lock:\n                    self.capturas.append(tuple(cap[:5]))\n   \
      \             self._cap = None\n        while it < len(tags):\n            self._info\
      \ = pmt.to_python(tags[it].value)\n            it += 1\n        return n\n"
    affinity: ''
    alias: ''
    cada_n_parejas: '6'
    comment: 'Monitor para la GUI:

      salidas de los correladores'
    maxoutbuf: '0'
    minoutbuf: '0'
    n_vec: n_vec
  states:
    _io_cache: '(''Monitor compresion de pulso'', ''blk'', [(''n_vec'', ''3333''),
      (''cada_n_parejas'', ''6'')], [(''0'', ''complex'', 1), (''1'', ''complex'',
      1), (''2'', ''complex'', 1)], [], ''Monitor (para la GUI): guarda cada tanto
      la salida de los correladores A y B\n    y de la suma A + B para una misma pareja
      de disparos.'', [])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1552, 568]
    rotation: 0
    state: enabled
- name: monitor_rx
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nMonitor de la senal recibida (solo visualizacion, receptor\
      \ real).\n\nCada 'cada_n_parejas' parejas copia una pareja completa de disparos\n\
      (A y luego B = 2*n_vec muestras), junto con la informacion del tag 'sondeo'\n\
      (frecuencia). La interfaz grafica lee el atributo 'capturas'.\n\"\"\"\nimport\
      \ collections\nimport threading\nimport numpy as np\nimport pmt\nfrom gnuradio\
      \ import gr\n\nTAG_SONDEO = pmt.intern('sondeo')\n\n\nclass blk(gr.sync_block):\n\
      \    \"\"\"Monitor (para la GUI): guarda cada tanto una pareja de disparos A/B\n\
      \    de la senal recibida.\"\"\"\n\n    def __init__(self, n_vec=3333, cada_n_parejas=6):\n\
      \        gr.sync_block.__init__(self, name='Monitor senal recibida',\n     \
      \                          in_sig=[np.complex64], out_sig=None)\n        self._n\
      \ = 2 * int(n_vec)\n        self._cada = max(1, int(cada_n_parejas))\n     \
      \   self._info = {}\n        self._cap = None\n        self.lock = threading.Lock()\n\
      \        self.capturas = collections.deque(maxlen=8)   # (n_pareja, info, rx,\
      \ None)\n\n    def work(self, input_items, output_items):\n        rx = input_items[0]\n\
      \        n = len(rx)\n        base = self.nitems_read(0)\n        tags = sorted(self.get_tags_in_window(0,\
      \ 0, n, TAG_SONDEO), key=lambda t: t.offset)\n        it = 0\n        i = 0\n\
      \        while i < n:\n            pos = base + i\n            while it < len(tags)\
      \ and tags[it].offset <= pos:\n                self._info = pmt.to_python(tags[it].value)\n\
      \                it += 1\n            if self._cap is None:\n              \
      \  resto = pos % self._n\n                if resto:                        \
      \           # esperar el inicio de la pareja\n                    i += self._n\
      \ - resto\n                    continue\n                pareja = pos // self._n\n\
      \                if pareja % self._cada:\n                    i += self._n\n\
      \                    continue\n                self._cap = [pareja, dict(self._info),\
      \ np.empty(self._n, np.complex64), 0]\n            cap = self._cap\n       \
      \     k = min(self._n - cap[3], n - i)\n            cap[2][cap[3]:cap[3] + k]\
      \ = rx[i:i + k]\n            cap[3] += k\n            i += k\n            if\
      \ cap[3] == self._n:\n                with self.lock:\n                    self.capturas.append((cap[0],\
      \ cap[1], cap[2], None))\n                self._cap = None\n        while it\
      \ < len(tags):\n            self._info = pmt.to_python(tags[it].value)\n   \
      \         it += 1\n        return n\n"
    affinity: ''
    alias: ''
    cada_n_parejas: '6'
    comment: 'Monitor para la GUI:

      senal recibida'
    maxoutbuf: '0'
    minoutbuf: '0'
    n_vec: n_vec
  states:
    _io_cache: '(''Monitor senal recibida'', ''blk'', [(''n_vec'', ''3333''), (''cada_n_parejas'',
      ''6'')], [(''0'', ''complex'', 1)], [], ''Monitor (para la GUI): guarda cada
      tanto una pareja de disparos A/B\n    de la senal recibida.'', [])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1088, 568]
    rotation: 0
    state: enabled
