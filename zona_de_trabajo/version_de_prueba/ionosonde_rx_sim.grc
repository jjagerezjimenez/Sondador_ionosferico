    bus_source: false
    bus_structure: null
    coordinate: [520, 108]
    rotation: 0
    state: enabled
- name: dh_km
  id: variable
  parameters:
    comment: 'km por muestra = 0.7495

      (h'' = c t / 2)'
    value: c_luz / (2.0 * samp_rate) / 1000.0
