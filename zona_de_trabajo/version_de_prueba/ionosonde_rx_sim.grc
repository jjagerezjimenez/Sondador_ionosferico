    bus_structure: null
    coordinate: [1032, 576]
    rotation: 0
    state: enabled
- name: monitor_rx
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nMonitor de la senal recibida (solo visualizacion).\n\n\
      Cada 'cada_n_parejas' parejas copia una pareja completa de disparos\n(A y luego\
      \ B = 2*n_vec muestras) de la senal recibida y de los ecos sin\nruido, junto\
      \ con la informacion del tag 'sondeo' (frecuencia).\nLa interfaz grafica lee\
      \ el atributo 'capturas'.\n\"\"\"\nimport collections\nimport threading\nimport\
      \ numpy as np\nimport pmt\nfrom gnuradio import gr\n\nTAG_SONDEO = pmt.intern('sondeo')\n\
      \n\nclass blk(gr.sync_block):\n    \"\"\"Monitor (para la GUI): guarda cada\
      \ tanto una pareja de disparos A/B de la\n    senal recibida (entrada 0) y de\
      \ los ecos sin ruido (entrada 1).\"\"\"\n\n    def __init__(self, n_vec=3333,\
      \ cada_n_parejas=6):\n        gr.sync_block.__init__(self, name='Monitor senal\
      \ recibida',\n                               in_sig=[np.complex64, np.complex64],\
      \ out_sig=None)\n        self._n = 2 * int(n_vec)\n        self._cada = max(1,\
      \ int(cada_n_parejas))\n        self._info = {}\n        self._cap = None\n\
      \        self.lock = threading.Lock()\n        self.capturas = collections.deque(maxlen=8)\
      \   # (n_pareja, info, rx, limpia)\n\n    def work(self, input_items, output_items):\n\
      \        rx, limpia = input_items\n        n = len(rx)\n        base = self.nitems_read(0)\n\
      \        tags = sorted(self.get_tags_in_window(0, 0, n, TAG_SONDEO), key=lambda\
      \ t: t.offset)\n        it = 0\n        i = 0\n        while i < n:\n      \
      \      pos = base + i\n            while it < len(tags) and tags[it].offset\
      \ <= pos:\n                self._info = pmt.to_python(tags[it].value)\n    \
      \            it += 1\n            if self._cap is None:\n                resto\
      \ = pos % self._n\n                if resto:                               \
      \    # esperar el inicio de la pareja\n                    i += self._n - resto\n\
      \                    continue\n                pareja = pos // self._n\n   \
      \             if pareja % self._cada:\n                    i += self._n\n  \
      \                  continue\n                self._cap = [pareja, dict(self._info),\
      \ np.empty(self._n, np.complex64),\n                             np.empty(self._n,\
      \ np.complex64), 0]\n            cap = self._cap\n            k = min(self._n\
      \ - cap[4], n - i)\n            cap[2][cap[4]:cap[4] + k] = rx[i:i + k]\n  \
      \          cap[3][cap[4]:cap[4] + k] = limpia[i:i + k]\n            cap[4] +=\
      \ k\n            i += k\n            if cap[4] == self._n:\n               \
      \ with self.lock:\n                    self.capturas.append(tuple(cap[:4]))\n\
      \                self._cap = None\n        while it < len(tags):\n         \
      \   self._info = pmt.to_python(tags[it].value)\n            it += 1\n      \
      \  return n\n"
    affinity: ''
    alias: ''
    cada_n_parejas: '6'
    comment: 'Monitor para la GUI:

      senal recibida y ecos sin ruido'
    maxoutbuf: '0'
    minoutbuf: '0'
    n_vec: n_vec
  states:
    _io_cache: '(''Monitor senal recibida'', ''blk'', [(''n_vec'', ''3333''), (''cada_n_parejas'',
      ''6'')], [(''0'', ''complex'', 1), (''1'', ''complex'', 1)], [], ''Monitor (para
      la GUI): guarda cada tanto una pareja de disparos A/B de la\n    senal recibida
      (entrada 0) y de los ecos sin ruido (entrada 1).'', [])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [336, 576]
    rotation: 0
    state: enabled
